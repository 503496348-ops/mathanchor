# ============================================
# 数理锚点(MathAnchor) 环境变量配置模板
# ============================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填入你的真实 API Key
# 3. 不要将 .env 提交到 Git（已在 .gitignore 中）
# ============================================

# ============================================
# 品牌化皮肤配置（可按项目定制）
# ============================================
# 应用名称（用于 UI 文案、PDF 标题、日志前缀）
APP_NAME=数理锚点

# 当前应用版本号（用于展示与更新对比）
APP_VERSION=1.0.0

# 可选：用于构建更新判断时的 buildNumber（优先级高于 APP_VERSION 解析）
APP_BUILD_NUMBER=

# 主域名/接口基地址（可按你自己的后端改造）
AUTH_API_BASE_URL=https://your-domain.com/api/auth
LIBRARY_API_BASE_URL=https://your-domain.com/api/library

# GeoGebra 聊天服务地址（本地/远程）
GEOGEBRA_CHAT_URL=https://example.com/api/geogebra/chat

# 导出文件名基础前缀（如 mathanchor_export_...）
APP_EXPORT_FILENAME=mathanchor_export

# 可选：更新检查端点（返回 version.json）
# 示例响应: {"version":"2.3.3","buildNumber":2030,"apkUrl":"...","releaseNotes":"..."}
APP_UPDATE_VERSION_URL=

# 功能开关
APP_FEATURE_VIDEO_RECOMMENDATION=false
APP_FEATURE_AUTO_UPDATE_CHECK=false

# ============================================
# 火山引擎（豆包）API
# ============================================
# 获取地址: https://console.volcengine.com/ark
# 主要用于：多模态 OCR 识别、手写体识别
VOLC_API_KEY=
VOLC_MODEL_ID=ep-xxxxxxxxxxxxxxxxxxxx
VOLC_OCR_MODEL_ID=ep-xxxxxxxxxxxxxxxxxxxx
VOLC_SOLVER_MODEL_ID=ep-xxxxxxxxxxxxxxxxxxxx
VOLC_VIS_MODEL_ID=ep-xxxxxxxxxxxxxxxxxxxx
VOLC_REQUEST_FORMAT=auto
VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# ============================================
# 阿里云 Qwen（通义千问）API
# ============================================
# 获取地址: https://dashscope.aliyuncs.com/
# 主要用于：流式对话、视频推荐、标题生成
VIVO_API_KEY=
VIVO_MODEL_ID=qwen-plus
VIVO_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# ============================================
# DeepSeek API
# ============================================
# 获取地址: https://platform.deepseek.com/
# 主要用于：数学推理、几何可视化 JSON 生成
# （可选，如果不使用 DeepSeek，可留空）
DEEPSEEK_API_KEY=
# 可填 https://api.deepseek.com（或直接填 .../chat/completions）
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL_ID=deepseek-chat

# ============================================
# 日志与运行行为
# ============================================
# 日志级别（debug/info/warning/error）
LOG_LEVEL=info

# 默认年级选择（primary/初中/high）
DEFAULT_GRADE=high
